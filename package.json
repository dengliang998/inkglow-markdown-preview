{
  "name": "inkglow-markdown-preview",
  "displayName": "墨光 Markdown 预览",
  "description": "一款专注的 VS Code Markdown 预览插件，支持 Mermaid、KaTeX、代码高亮和安全的本地资源访问。",
  "version": "0.0.12",
  "publisher": "local",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/inkglow-markdown-preview"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Markdown",
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "mermaid",
    "katex",
    "math"
  ],
  "activationEvents": [
    "onCommand:inkglowMarkdownPreview.open",
    "onCommand:inkglowMarkdownPreview.openToSide",
    "onCommand:inkglowMarkdownPreview.exportPdf"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "inkglowMarkdownPreview.open",
        "title": "墨光 Markdown 预览：打开预览",
        "enablement": "resourceLangId == markdown"
      },
      {
        "command": "inkglowMarkdownPreview.openToSide",
        "title": "墨光 Markdown 预览：在侧边打开预览",
        "enablement": "resourceLangId == markdown"
      },
      {
        "command": "inkglowMarkdownPreview.exportPdf",
        "title": "墨光 Markdown 预览：导出 PDF",
        "enablement": "resourceLangId == markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "inkglowMarkdownPreview.open",
          "when": "resourceLangId == markdown",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "inkglowMarkdownPreview.open",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "inkglowMarkdownPreview.openToSide",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "inkglowMarkdownPreview.exportPdf",
          "when": "resourceLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "墨光 Markdown 预览",
      "properties": {
        "inkglowMarkdownPreview.allowRemoteImages": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Allow previewed documents to load images over HTTPS. Disable this for a fully local preview."
        },
        "inkglowMarkdownPreview.chromePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional absolute path to a Chrome or Chromium executable used for PDF export."
        },
        "inkglowMarkdownPreview.export.paperSize": {
          "type": "string",
          "enum": ["A4", "A3", "Letter"],
          "enumDescriptions": ["210 × 297 mm", "297 × 420 mm", "8.5 × 11 in"],
          "default": "A4",
          "markdownDescription": "Paper size used by PDF export."
        },
        "inkglowMarkdownPreview.export.orientation": {
          "type": "string",
          "enum": ["portrait", "landscape"],
          "default": "portrait",
          "markdownDescription": "Page orientation used by PDF export."
        },
        "inkglowMarkdownPreview.export.margin": {
          "type": "string",
          "enum": ["narrow", "normal", "wide"],
          "default": "normal",
          "markdownDescription": "Page margin preset used by PDF export."
        },
        "inkglowMarkdownPreview.export.theme": {
          "type": "string",
          "enum": ["light", "dark"],
          "default": "light",
          "markdownDescription": "Color theme used by PDF export."
        },
        "inkglowMarkdownPreview.export.includeOutline": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Add a table of contents as the first PDF page."
        },
        "inkglowMarkdownPreview.export.headerText": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional repeated header text in exported PDFs."
        },
        "inkglowMarkdownPreview.export.footerText": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional repeated footer text in exported PDFs."
        },
        "inkglowMarkdownPreview.export.customCss": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional CSS appended to the PDF export document."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "package": "pnpm run build && npx @vscode/vsce package --no-dependencies",
    "test": "pnpm run check && pnpm run build"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.6.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "@vscode/vsce": "^3.2.1"
  }
}
